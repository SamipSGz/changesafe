# TrueForge server (started separately with: npx @truefoundry/trueforge)
TRUEFORGE_BASE_URL=http://localhost:8790

# Port for our custom "actions" MCP server (send_email / create_support_ticket / book_meeting)
ACTIONS_MCP_PORT=8791

# Model provider credentials are configured inside the TrueForge UI (Settings -> Models),
