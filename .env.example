# TrueForge server (started separately with: npx @truefoundry/trueforge)
TRUEFORGE_BASE_URL=http://localhost:8790

# Port for our custom "db" MCP server (inspect_schema / query_readonly /
# preview_change / commit_change / rollback_change)
DB_MCP_PORT=8791

# Model provider credentials are configured inside the TrueForge UI (Settings
# -> Models), NOT in this repo. Bring your own key for OpenAI / Anthropic /
# Gemini / etc. Override which model the agent uses (must match a model id
# in TrueForge's catalog):
# TRUEFORGE_MODEL=anthropic/claude-sonnet-4-6
