{
  "name": "changesafe",
  "version": "0.1.0",
  "private": true,
  "description": "An AI database operator built on TrueForge: investigates and previews changes freely, but every irreversible commit is gated behind human approval.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:seed": "tsx src/db/seed.ts",
    "tools:dev": "tsx watch src/tools/db-mcp-server.ts",
    "tools:start": "node dist/tools/db-mcp-server.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
