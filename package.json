{
  "name": "license-to-act",
  "version": "0.1.0",
  "private": true,
  "description": "An approval-gated action assistant built on TrueForge for the Agent Harness Hackathon.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "tools:dev": "tsx watch src/tools/actions-mcp-server.ts",
    "tools:start": "node dist/tools/actions-mcp-server.js",
    "agent:register": "tsx src/agent/registerAgent.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
